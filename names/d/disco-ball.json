ipedia.org/wiki/File%3AFotothek_df_n-15_0000413_Disko.jpg"}],"sounds":{"disco ball":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/83/En-us-disco_ball.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/83/En-us-disco_ball.ogg/En-us-disco_ball.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/4/44/En-au-disco_ball.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/44/En-au-disco_ball.ogg/En-au-disco_ball.ogg.mp3"}]},"pictures":[{"title":"Werner's nomenclature of colours greys","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Werner%27s_nomenclature_of_colours_greys.jpg/500px-Werner%27s_nomenclature_of_colours_greys.jpg","ratio":0.794047619047619,"link":"https://commons.wikimedia.org/wiki/File:Werner%27s_nomenclature_of_colours_greys.jpg","share":0.78375},{"title":"Grey heron (00129p)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Grey_heron_%2800129p%29.jpg/500px-Grey_heron_%2800129p%29.jpg","ratio":0.8691693290734824,"link":"https://commons.wikimedia.org/wiki/File:Grey_heron_(00129p).jpg","share":0.605},{"title":"Disco ball with reflections 01","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Disco_ball_with_reflections_01.JPG/500px-Disco_ball_with_reflections_01.JPG","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Disco_ball_with_reflections_01.JPG","share":0.166875},{"title":"Disco-ball-self-portrait","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/56/Disco-ball-self-portrait.jpg/500px-Disco-ball-self-portrait.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Disco-ball-self-portrait.jpg","share":0.135625},{"title":"Disco ball with reflections 05","ima