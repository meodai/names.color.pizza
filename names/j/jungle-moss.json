/wiki/File%3ABryum_capillare_leaf_cells.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Moss_leaf_under_microscope.jpg/500px-Moss_leaf_under_microscope.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Moss_leaf_under_microscope.jpg/1280px-Moss_leaf_under_microscope.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Moss_leaf_under_microscope.jpg/500px-Moss_leaf_under_microscope.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Moss leaf under microscope, showing gemmae and a hair point (40×)","link":"https://en.wikipedia.org/wiki/File%3AMoss_leaf_under_microscope.jpg"}],"sounds":{"jungle":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/6/68/En-us-jungle.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/68/En-us-jungle.ogg/En-us-jungle.ogg.mp3"}],"moss":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/32/En-us-moss.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/32/En-us-moss.ogg/En-us-moss.ogg.mp3"}]}}}