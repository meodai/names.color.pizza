kipedia/commons/thumb/0/07/MajorVolcanoesOfThePhilippines-USGS.gif/330px-MajorVolcanoesOfThePhilippines-USGS.gif?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/MajorVolcanoesOfThePhilippines-USGS.gif/330px-MajorVolcanoesOfThePhilippines-USGS.gif?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Map showing major volcanoes of the Philippines","link":"https://en.wikipedia.org/wiki/File%3AMajorVolcanoesOfThePhilippines-USGS.gif"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Mayon_Volcano_2013.jpg/500px-Mayon_Volcano_2013.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Mayon_Volcano_2013.jpg/1280px-Mayon_Volcano_2013.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Mayon_Volcano_2013.jpg/500px-Mayon_Volcano_2013.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Mount Mayon in 2013","link":"https://en.wikipedia.org/wiki/File%3AMayon_Volcano_2013.jpg"}],"sounds":{"mist":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/4/49/En-us-mist.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/49/En-us-mist.ogg/En-us-mist.ogg.mp3"}]}}}