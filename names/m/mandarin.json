:"https://en.wikipedia.org/wiki/File%3ABen_Kingsley_by_Gage_Skidmore.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Tony_Leung_%28cropped%29.jpg/250px-Tony_Leung_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://upload.wikimedia.org/wikipedia/commons/3/37/Tony_Leung_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Tony_Leung_%28cropped%29.jpg/250px-Tony_Leung_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Tony Leung in 2016","link":"https://en.wikipedia.org/wiki/File%3ATony_Leung_(cropped).jpg"}],"sounds":{"Mandarin":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/1/15/En-us-mandarin.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/15/En-us-mandarin.ogg/En-us-mandarin.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/1/15/En-au-mandarin.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/15/En-au-mandarin.ogg/En-au-mandarin.ogg.mp3"}]}}}