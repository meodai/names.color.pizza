px-Victor-Mousetrap.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A spring mousetrap by Victor","link":"https://en.wikipedia.org/wiki/File%3AVictor-Mousetrap.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Ausl%C3%B6sen_einer_Mausefalle.gif/500px-Ausl%C3%B6sen_einer_Mausefalle.gif?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Ausl%C3%B6sen_einer_Mausefalle.gif/500px-Ausl%C3%B6sen_einer_Mausefalle.gif?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Triggering a mousetrap","link":"https://en.wikipedia.org/wiki/File%3AAusl%C3%B6sen_einer_Mausefalle.gif"}],"sounds":{"mouse trap":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/0/0e/LL-Q1860_%28eng%29-Flame%2C_not_lame-mousetrap.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/LL-Q1860_%28eng%29-Flame%2C_not_lame-mousetrap.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-mousetrap.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/LL-Q1860_%28eng%29-Flame%2C_not_lame-mousetrap.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-mousetrap.wav.ogg"}]}}}