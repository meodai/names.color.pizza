ikimedia.org/wikipedia/commons/thumb/3/3b/Kaolinite-Orthoclase-lw18c.jpg/330px-Kaolinite-Orthoclase-lw18c.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3b/Kaolinite-Orthoclase-lw18c.jpg/330px-Kaolinite-Orthoclase-lw18c.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"When minerals react, the products will sometimes assume the shape of the reagent; the product mineral is termed a pseudomorph of (or after) the reagent. Illustrated here is a pseudomorph of kaolinite after orthoclase. Here, the pseudomorph preserved the Carlsbad twinning common in orthoclase.","link":"https://en.wikipedia.org/wiki/File%3AKaolinite-Orthoclase-lw18c.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Topaz-235220.jpg/500px-Topaz-235220.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/be/Topaz-235220.jpg/500px-Topaz-235220.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Topaz has a characteristic orthorhombic elongated crystal shape.","link":"https://en.wikipedia.org/wiki/File%3ATopaz-235220.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Spinel-4mb4c.jpg/330px-Spinel-4mb4c.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Spinel-4mb4c.jpg/330px-Spinel-4mb4c.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Contact twins, as seen in spinel","link":"https://en.wikipedia.org/wiki/File%3ASpinel-4mb4c.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/Rough_diamond.jpg/330px-Rough_diamond.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/Rough_diamond.jpg/330px-Rough_diamond.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Diamond is the hardest natural material, and has a Mohs hardness of 10.","link":"https://en.wikipedia.org/wiki/File%3ARough_diamond.jpg"}],"sounds":{}}}