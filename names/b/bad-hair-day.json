m_campaign=parser&utm_content=thumbnail","alt":"Human hair contains melanin which provides dark coloration and protection from UV radiation. Human hair can absorb and emit light across a wide range of wavelengths. The image above depicts melanin autofluorescence at 365-400 nm excitation from a strand of dark brown human hair.","link":"https://en.wikipedia.org/wiki/File%3AHair_Autofluorescence.jpg"}],"sounds":{"bad hair day":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/7/71/En-au-bad_hair_day.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/71/En-au-bad_hair_day.ogg/En-au-bad_hair_day.ogg.mp3"}]},"pictures":[{"title":"Bad hair day (11891776685)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/74/Bad_hair_day_%2811891776685%29.jpg/500px-Bad_hair_day_%2811891776685%29.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Bad_hair_day_(11891776685).jpg","share":0.089375},{"title":"1995 UAZ 2206 beige rear","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/1995_UAZ_2206_beige_rear.jpg/500px-1995_UAZ_2206_beige_rear.jpg","ratio":1.2959381044487428,"link":"https://commons.wikimedia.org/wiki/File:1995_UAZ_2206_beige_rear.jpg","share":0.045625}]}}