_Indonesia.jpg/500px-ISS-47_Islands_In_The_Sky%2C_Indonesia.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Earth from orbit, showing sunlight filtered into a reddish hue by the troposphere, while casting shadows from different cloud types. The stratosphere forms a thin band of blue scattered sunlight along the horizon.","link":"https://en.wikipedia.org/wiki/File%3AISS-47_Islands_In_The_Sky%2C_Indonesia.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Profil_temperature_atmosphere.png/500px-Profil_temperature_atmosphere.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Profil_temperature_atmosphere.png/500px-Profil_temperature_atmosphere.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Temperature change by altitude","link":"https://en.wikipedia.org/wiki/File%3AProfil_temperature_atmosphere.png"}],"sounds":{"breath of fresh air":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/c/c7/En-au-breath_of_fresh_air.ogg?utm_source=en.wiktionary.org&utm_campaign=api&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c7/En-au-breath_of_fresh_air.ogg/En-au-breath_of_fresh_air.ogg.mp3"}]},"pictures":[{"title":"Grey heron (00129p)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Grey_heron_%2800129p%29.jpg/500px-Grey_heron_%2800129p%29.jpg","ratio":0.8691693290734824,"link":"https://commons.wikimedia.org/wiki/File:Grey_heron_(00129p).jpg","share":0.50875},{"title":"Urmia air pollution 20 (Mehr, 2025)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Urmia_air_pollution_20_%28Mehr%2C_2025%29.jpg/500px-Urmia_air_pollution_20_%28Mehr%2C_2025%29.jpg","ratio":1.5005861664712778,"link":"https://commons.wikimedia.org/wiki/File:Urmia_air_pollution_20_(Mehr,_2025).jpg","