sus_winter_beach.png/500px-Summer_versus_winter_beach.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Summer_versus_winter_beach.png/500px-Summer_versus_winter_beach.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The differences between summer and winter on beaches in areas where the winter conditions are rougher and waves have a shorter wavelength but higher energy. In winter, sand from the beach is stored offshore.[2]","link":"https://en.wikipedia.org/wiki/File%3ASummer_versus_winter_beach.png"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/500px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/1280px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/500px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AScala_dei_Turchi_Sand_062313.jpg"}],"sounds":{"beach":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/3d/En-uk-beach.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/En-uk-beach.ogg/En-uk-beach.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/dc/En-us-beach.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/dc/En-us-beach.ogg/En-us-beach.ogg.mp3"}],"foam":