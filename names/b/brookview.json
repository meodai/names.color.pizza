{"name":"Brookview","hex":"#99b792","fetched":"2026-10-11","looked":{"definitions":[],"entries":[{"title":"Brookview, Maryland","blocks":[{"text":"Brookview is a town in Dorchester County, Maryland, United States. The population was 48 at the 2020 census. Brookview was incorporated in 1953."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e1/Dorchester_County_Maryland_Incorporated_and_Unincorporated_areas_Brookview_Highlighted.svg/330px-Dorchester_County_Maryland_Incorporated_and_Unincorporated_areas_Brookview_Highlighted.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Brookview%2C_Maryland","wikidata":"Q756415"},{"title":"Brookview, New Jersey","blocks":[{"text":"Brookview is an unincorporated community located within East Brunswick Township in Middlesex County, in the U.S. state of New Jersey. The settlement is located along Church Lane at the former Newark–Trenton Fast Line right-of-way, now a PSE&G transmission line corridor. The Brookview Volunteer Fire Company, established in 1952, takes its name from the settlement."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Brookview%2C_NJ.jpg/330px-Brookview%2C_NJ.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Brookview%2C_New_Jersey","wikidata":"Q19460686"}],"images":[],"sounds":{},"pictures":[{"title":"Brookview, NJ","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/Brookview%2C_NJ.jpg/500px-Brookview%2C_NJ.jpg","ratio":1.597504924491136,"link":"https://commons.wikimedia.org/wiki/File:Brookview,_NJ.jpg","share":0.098125},{"title":"Holland Brook2","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/Holland_Brook2.JPG/500px-Holland_Brook2.JPG","ratio":0.75,"link":"https://commons.wikimedia.org/wiki/File:Holland_Brook2.JPG","share":0.069375},{"title":"Merak tarung","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2