{"name":"Arancio","hex":"#ff7013","fetched":"2026-10-11","looked":{"definitions":[],"entries":[{"title":"Lago Arancio","blocks":[{"text":"Lago Arancio is a lake in the Province of Agrigento, Sicily, Italy. The reservoir is located on the territory of the municipalities of Sambuca di Sicilia, Santa Margherita di Belice and Sciacca. It was created in 1951, and has a surface area of 3.7 km2 and an average depth of 10.5m."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Lagoarancio.jpg/330px-Lagoarancio.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Lago_Arancio","wikidata":"Q3825627"},{"title":"Francesco Arancio","blocks":[{"text":"Francesco Arancio (1844–?) was an Italian painter."}],"link":"https://en.wikipedia.org/wiki/Francesco_Arancio","wikidata":"Q5479183"}],"images":[],"sounds":{},"pictures":[{"title":"Orange -- 2022 -- 9711","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Orange_--_2022_--_9711.jpg/500px-Orange_--_2022_--_9711.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Orange_--_2022_--_9711.jpg","share":0.391875},{"title":"Orange -- 2022 -- 9721","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Orange_--_2022_--_9721.jpg/500px-Orange_--_2022_--_9721.jpg","ratio":1,"link":"https://commons.wikimedia.org/wiki/File:Orange_--_2022_--_9721.jpg","share":0.328125},{"title":"Orange -- 2022 -- 9713","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/Orange_--_2022_--_9713.jpg/500px-Orange_--_2022_--_9713.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Orange_--_2022_--_9713.jpg","share":0.278125},{"title":"Orange Fruit Close-up","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bf/Orange_Fruit_Close-up.jpg/500px-Orange_Fruit_Close-up.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Orange_Fruit_Close-up.jpg","share":0.22125},{"title":"Orange-Fruit-Pieces","image":"https://