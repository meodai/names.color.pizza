.org/wikipedia/commons/1/13/En-us-breed.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/1/13/En-us-breed.ogg/En-us-breed.ogg.mp3"}]},"pictures":[{"title":"Illustration Olea europaea0","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Illustration_Olea_europaea0.jpg/500px-Illustration_Olea_europaea0.jpg","ratio":0.6118909991742362,"link":"https://commons.wikimedia.org/wiki/File:Illustration_Olea_europaea0.jpg","share":0.101875},{"title":"Olea europaea - Köhler–s Medizinal-Pflanzen-229","image":"https://upload.wikimedia.org/wikipedia/commons/1/16/Olea_europaea_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-229.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","ratio":0.8690036900369004,"link":"https://commons.wikimedia.org/wiki/File:Olea_europaea_-_K%C3%B6hler%E2%80%93s_Medizinal-Pflanzen-229.jpg","share":0.08375}]}}