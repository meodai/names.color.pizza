{"name":"Antiqued Aqua","hex":"#bdccc1","fetched":"2026-10-11","looked":{"definitions":[{"term":"antiqued","whole":false,"parts":[{"part":"Verb","definitions":["simple past and past participle of antique"]}],"link":"https://en.wiktionary.org/wiki/antiqued"},{"term":"aqua","whole":false,"parts":[{"part":"Noun","definitions":["Water (as a compound).","A shade of colour, usually a mix of blue and green, most often similar to the colour cyan, though also sometimes closer to turquoise or aquamarine."]},{"part":"Adjective","definitions":["Of a greenish-blue colour."]}],"link":"https://en.wiktionary.org/wiki/aqua"}],"entries":[{"title":"Aqua (color)","blocks":[{"text":"Aqua is a variation of the color cyan. The normalized color coordinates for the two web colors named aqua and cyan are identical. It was one of the three secondary colors of the RGB color model used on computer and television displays. In the HSV color wheel aqua is precisely halfway between blue and green. However, aqua is not the same as the primary subtractive color named process cyan used in printing."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/27/Shaheed_Island%2C_Andamans%2C_Bay%2C_Turquoise_water.jpg/330px-Shaheed_Island%2C_Andamans%2C_Bay%2C_Turquoise_water.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Aqua_(color)","wikidata":"Q372733"}],"images":[],"sounds":{"aqua":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/a/a5/LL-Q1860_%28eng%29-Vealhurl-aqua.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a5/LL-Q1860_%28eng%29-Vealhurl-aqua.wav/LL-Q1860_%28eng%29-Vealhurl-aqua.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a5/LL-Q1860_%28eng%29-Vealhurl-aqua.wav/LL-Q1860_%28eng%29-Vealhurl-aqua.wav.ogg"}]},"pictures"