thumb/f/f5/02_Coleton_Fishacre.JPG/1280px-02_Coleton_Fishacre.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/02_Coleton_Fishacre.JPG/500px-02_Coleton_Fishacre.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Coleton Fishacre was designed in 1925 as a holiday home in Kingswear, Devon, England, in the Arts and Crafts tradition.","link":"https://en.wikipedia.org/wiki/File%3A02_Coleton_Fishacre.JPG"}],"sounds":{},"pictures":[{"title":"Vase with lamps, Brown and beige textures, Rostov-on-Don, Russia","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Vase_with_lamps%2C_Brown_and_beige_textures%2C_Rostov-on-Don%2C_Russia.jpg/500px-Vase_with_lamps%2C_Brown_and_beige_textures%2C_Rostov-on-Don%2C_Russia.jpg","ratio":1.5049019607843137,"link":"https://commons.wikimedia.org/wiki/File:Vase_with_lamps,_Brown_and_beige_textures,_Rostov-on-Don,_Russia.jpg","share":0.24},{"title":"Brown ornaments on doors, Reflections, Rostov-on-Don, Russia","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Brown_ornaments_on_doors%2C_Reflections%2C_Rostov-on-Don%2C_Russia.jpg/500px-Brown_ornaments_on_doors%2C_Reflections%2C_Rostov-on-Don%2C_Russia.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Brown_ornaments_on_doors,_Reflections,_Rostov-on-Don,_Russia.jpg","share":0.196875},{"title":"Brown Rat (Rattus norvegicus) also called Norway Rat or Common Rat -with food container - Mathias Baldwin Park, Philadelphia, Pennsylvania, USA","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Brown_Rat_%28Rattus_norvegicus%29_also_called_Norway_Rat_or_Common_Rat_-with_food_container_-_Mathias_Baldwin_Park%2C_Philadelphia%2C_Pennsylvania%2C_USA.jpg/500px-Brown_Rat_%28Rattus_norvegicus%29_also_called_Norway_Rat_or_Common_Rat_-with_food_container_-_Mathias_Baldwin_Park%2C_Philadelphia%2C_Pennsylvania%2C_USA.jpg","ratio":1.5002