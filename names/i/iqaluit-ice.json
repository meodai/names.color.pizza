uit.","link":"https://en.wikipedia.org/wiki/File%3AApex_Nunavut.JPG"}],"sounds":{"ice":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/7/74/En-us-ice.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/7/74/En-us-ice.ogg/En-us-ice.ogg.mp3"},{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/0/01/LL-Q1860_%28eng%29-Back_ache-ice.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/01/LL-Q1860_%28eng%29-Back_ache-ice.wav/LL-Q1860_%28eng%29-Back_ache-ice.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/01/LL-Q1860_%28eng%29-Back_ache-ice.wav/LL-Q1860_%28eng%29-Back_ache-ice.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/d7/He_said%2C_%E2%80%9CWhere_we%E2%80%99re_at_right_now_was.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/He_said%2C_%E2%80%9CWhere_we%E2%80%99re_at_right_now_was.ogg/He_said%2C_%E2%80%9CWhere_we%E2%80%99re_at_right_now_was.ogg.mp3"}]}}}