{"name":"Icecap","hex":"#c3d6e0","fetched":"2026-10-12","looked":{"definitions":[{"term":"icecap","whole":true,"parts":[{"part":"Noun","definitions":["Alternative form of ice cap."]}],"link":"https://en.wiktionary.org/wiki/icecap"}],"entries":[{"title":"Ice cap","blocks":[{"text":"In glaciology, an ice cap is a mass of ice that covers less than 50,000 km2 (19,000 mi2) of land area. Larger ice masses covering more than 50,000 km2 (19,000 mi2) are termed ice sheets."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Vatnaj%C3%B6kull.jpeg/330px-Vatnaj%C3%B6kull.jpeg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Ice_cap","wikidata":"Q878077"}],"images":[],"sounds":{}}}