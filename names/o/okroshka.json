{"name":"Okroshka","hex":"#40533d","fetched":"2026-10-12","looked":{"definitions":[{"term":"okroshka","whole":true,"parts":[{"part":"Noun","definitions":["A cold raw vegetable soup, part of the national cuisines of Russia and Ukraine. Usually made by pouring kvass or kefir in a pot of diced cucumber, radish, green onion, boiled potato, boiled egg, sausage or meat, sour cream, and seasoned with dill and parsley."]}],"link":"https://en.wiktionary.org/wiki/okroshka"}],"entries":[{"title":"Okroshka","blocks":[{"text":"Okróshka is a cold soup of Russian origin, which probably originated in the Volga region."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/96/%D0%93%D0%BE%D1%82%D0%BE%D0%B2%D0%B0%D1%8F_%D0%BE%D0%BA%D1%80%D0%BE%D1%88%D0%BA%D0%B0.jpg/330px-%D0%93%D0%BE%D1%82%D0%BE%D0%B2%D0%B0%D1%8F_%D0%BE%D0%BA%D1%80%D0%BE%D1%88%D0%BA%D0%B0.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Okroshka","wikidata":"Q611164"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Kefir-okroshka.jpg/250px-Kefir-okroshka.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Kefir-okroshka.jpg/500px-Kefir-okroshka.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Kefir-okroshka.jpg/250px-Kefir-okroshka.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AKefir-okroshka.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/%D0%9E%D0%BA%D1%80%D0%BE%D1%88%D0%BA%D0%B01.JPG/250px-%D0%9E%D0%BA%D1%80%D0%BE%D1%88%D0%BA%D0%B01.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/%D0%9E%D0%BA%D1%80%D0%BE%D1%88%D0%BA%D0%B01.JPG/500px-%D0%9E%D0%BA%D1%