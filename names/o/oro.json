{"name":"Oro","hex":"#c29436","fetched":"2026-10-16","looked":{"definitions":[{"term":"Oro","whole":true,"parts":[{"part":"Proper noun","definitions":["A surname."]}],"link":"https://en.wiktionary.org/wiki/Oro"}],"entries":[{"title":"Montenegrin Oro","blocks":[{"text":"Crnogorsko oro, or simply oro is a Montenegrin national folk dance originating in the Dinaric region of the Western Balkans. The name 'oro' derives from the dialectal form of the word 'orao', meaning 'eagle', referring to how the dance is performed to resemble the movements of an eagle."}],"link":"https://en.wikipedia.org/wiki/Montenegrin_Oro","wikidata":"Q55627894"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/en/thumb/6/60/Oro%2C_the_Montenegrin_Eagle_Dance.jpg/330px-Oro%2C_the_Montenegrin_Eagle_Dance.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/en/thumb/6/60/Oro%2C_the_Montenegrin_Eagle_Dance.jpg/330px-Oro%2C_the_Montenegrin_Eagle_Dance.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Oro being performed in the Morača region, 1965","link":"https://en.wikipedia.org/wiki/File%3AOro%2C_the_Montenegrin_Eagle_Dance.jpg"}],"sounds":{}}}