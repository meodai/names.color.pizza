edia/commons/thumb/f/f5/NJ_LBI_Lighthouse_04.JPG/500px-NJ_LBI_Lighthouse_04.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f5/NJ_LBI_Lighthouse_04.JPG/500px-NJ_LBI_Lighthouse_04.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Lighthouse at the coast of Ocean County, New Jersey, U.S., facing the Atlantic Ocean at sunrise","link":"https://en.wikipedia.org/wiki/File%3ANJ_LBI_Lighthouse_04.JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg/500px-Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg/1280px-Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg/500px-Season-long_composites_of_ocean_chlorophyll_%288161799575%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Ocean chlorophyll concentration is a proxy for phytoplankton biomass. In this map, blue colors represent lower chlorophyll and reds represent higher chlorophyll. Satellite-measured chlorophyll is estimated based on ocean color by how green the color of the water appears from space.","link":"https://en.wikipedia.org/wiki/File%3ASeason-long_composites_of_ocean_chlorophyll_(8161799575).jpg"}],"sounds":{"ocean":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/4/46/En-us-ocean.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wi