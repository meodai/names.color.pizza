n.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AChrysoskalitissa_R02.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Lago_di_Lavarone_190820_03.jpg/500px-Lago_di_Lavarone_190820_03.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Lago_di_Lavarone_190820_03.jpg/1280px-Lago_di_Lavarone_190820_03.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Lago_di_Lavarone_190820_03.jpg/500px-Lago_di_Lavarone_190820_03.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3ALago_di_Lavarone_190820_03.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Man_o%27war_cove_near_lulworth_dorset_arp.jpg/500px-Man_o%27war_cove_near_lulworth_dorset_arp.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Man_o%27war_cove_near_lulworth_dorset_arp.jpg/1280px-Man_o%27war_cove_near_lulworth_dorset_arp.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Man_o%27war_cove_near_lulworth_dorset_arp.jpg/500px-Man_o%27war_cove_near_lulworth_dorset_arp.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AMan_o'war_cove_near_lulworth_dorset_arp.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/eb/Beach_zones.png/500px-Beach_zones.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/eb/Beach_zones.png/500px-Beach_zones.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A berm is a nearly horizontal portion that stays dry except during extremely high tides and storms. The swash zone is alternately covered and exposed by wave run-up. The beach face is the sloping section below the berm that is exposed to the swash of the waves. The wrack line (not shown here) is the highest reach of the daily tide where organic and inorganic debris is deposited by wave action. May have sand dunes.[2]","link":"https://en.wikipedia.org/wiki/File%3ABeach_zones.png"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Summer_versus_winter_beach.png/500px-Summer_versus_winter_beach.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a6/Summer_versus_winter_beach.png/500px-Summer_versus_winter_beach.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The differences between summer and winter on beaches in areas where the winter conditions are rougher and waves have a shorter wavelength but higher energy. In winter, sand from the beach is stored offshore.[2]","link":"https://en.wikipedia.org/wiki/File%3ASummer_versus_winter_beach.png"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/500px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/1280px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Scala_dei_Turchi_Sand_062313.jpg/500px-Scala_dei_Turchi_Sand_062313.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AScala_dei_Turchi_Sand_062313.jpg"}],"sounds":{"beach":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/3d/En-uk-beach.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3d/En-uk-beach.ogg/En-uk-beach.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/dc/En-us-beach.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/dc/En-us-beach.ogg/En-us-beach.ogg.mp3"}]},"pictures":[{"title":"Elafonisi pink sand beach - panoramio","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Elafonisi_pink_sand_beach_-_panoramio.jpg/500px-Elafonisi_pink_sand_beach_-_panoramio.jpg","ratio":1.5073929961089494,"link":"https://commons.wikimedia.org/wiki/File:Elafonisi_pink_sand_beach_-_panoramio.jpg","share":0.380625},{"title":"Werner's nomenclature of colours greys","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Werner%27s_nomenclature_of_colours_greys.jpg/500px-Werner%27s_nomenclature_of_colours_greys.jpg","ratio":0.794047619047619,"link":"https://commons.wikimedia.org/wiki/File:Werner%27s_nomenclature_of_colours_greys.jpg","share":0.363125},{"title":"Grey heron (00129p)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Grey_heron_%2800129p%29.jpg/500px-Grey_heron_%2800129p%29.jpg","ratio":0.8691693290734824,"link":"https://commons.wikimedia.org/wiki/File:Grey_heron_(00129p).jpg","share":0.245},{"title":"Grey-breasted mountain toucan (Andigena hypoglauca) Caldas","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Grey-breasted_mountain_toucan_%28Andigena_hypoglauca%29_Caldas.jpg/500px-Grey-breasted_mountain_toucan_%28Andigena_hypoglauca%29_Caldas.jpg","ratio":0.7726960896409787,"link":"https://commons.wikimedia.org/wiki/File:Grey-breasted_mountain_toucan_(Andigena_hypoglauca)_Caldas.jpg","share":0.183125},{"title":"Elafonisi Beach, Chania Prefecture, Greece (2)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Elafonisi_Beach%2C_Chania_Prefecture%2C_Greece_%282%29.jpg/500px-Elafonisi_Beach%2C_Chania_Prefecture%2C_Greece_%282%29.jpg","ratio":1.3333333333333333,"link":"https://commons.wikimedia.org/wiki/File:Elafonisi_Beach,_Chania_Prefecture,_Greece_(2).jpg","share":0.178125},{"title":"Ελαφονήσι 0976","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/%CE%95%CE%BB%CE%B1%CF%86%CE%BF%CE%BD%CE%AE%CF%83%CE%B9_0976.jpg/500px-%CE%95%CE%BB%CE%B1%CF%86%CE%BF%CE%BD%CE%AE%CF%83%CE%B9_0976.jpg","ratio":1.5398936170212767,"link":"https://commons.wikimedia.org/wiki/File:%CE%95%CE%BB%CE%B1%CF%86%CE%BF%CE%BD%CE%AE%CF%83%CE%B9_0976.jpg","share":0.1575},{"title":"Elafonisi, Kandanos Selinos, Chania, Crete, Greece - panoramio","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Elafonisi%2C_Kandanos_Selinos%2C_Chania%2C_Crete%2C_Greece_-_panoramio.jpg/500px-Elafonisi%2C_Kandanos_Selinos%2C_Chania%2C_Crete%2C_Greece_-_panoramio.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Elafonisi,_Kandanos_Selinos,_Chania,_Crete,_Greece_-_panoramio.jpg","share":0.15},{"title":"Elafonisi Beach - sand taking prohibited sign","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Elafonisi_Beach_-_sand_taking_prohibited_sign.jpg/500px-Elafonisi_Beach_-_sand_taking_prohibited_sign.jpg","ratio":1.5003663003663004,"link":"https://commons.wikimedia.org/wiki/File:Elafonisi_Beach_-_sand_taking_prohibited_sign.jpg","share":0.1475},{"title":"Grey Carpet from above","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3c/Grey_Carpet_from_above.jpg/500px-Grey_Carpet_from_above.jpg","ratio":1.3333333333333333,"link":"https://commons.wikimedia.org/wiki/File:Grey_Carpet_from_above.jpg","share":0.1375},{"title":"Elafonisi Beach in Greece as seen from Elafonisi Island","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Elafonisi_Beach_in_Greece