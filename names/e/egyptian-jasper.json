asper_(32132824820).jpg"}],"sounds":{"jasper":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/e/e5/En-us-jasper.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e5/En-us-jasper.ogg/En-us-jasper.ogg.mp3"}]},"pictures":[{"title":"Vase with lamps, Brown and beige textures, Rostov-on-Don, Russia","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Vase_with_lamps%2C_Brown_and_beige_textures%2C_Rostov-on-Don%2C_Russia.jpg/500px-Vase_with_lamps%2C_Brown_and_beige_textures%2C_Rostov-on-Don%2C_Russia.jpg","ratio":1.5049019607843137,"link":"https://commons.wikimedia.org/wiki/File:Vase_with_lamps,_Brown_and_beige_textures,_Rostov-on-Don,_Russia.jpg","share":0.284375},{"title":"Brown ornaments on doors, Reflections, Rostov-on-Don, Russia","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/Brown_ornaments_on_doors%2C_Reflections%2C_Rostov-on-Don%2C_Russia.jpg/500px-Brown_ornaments_on_doors%2C_Reflections%2C_Rostov-on-Don%2C_Russia.jpg","ratio":1.5,"link":"https://commons.wikimedia.org/wiki/File:Brown_ornaments_on_doors,_Reflections,_Rostov-on-Don,_Russia.jpg","share":0.16625},{"title":"Brown Rat (Rattus norvegicus) also called Norway Rat or Common Rat -with food container - Mathias Baldwin Park, Philadelphia, Pennsylvania, USA","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/68/Brown_Rat_%28Rattus_norvegicus%29_also_called_Norway_Rat_or_Common_Rat_-with_food_container_-_Mathias_Baldwin_Park%2C_Philadelphia%2C_Pennsylvania%2C_USA.jpg/500px-Brown_Rat_%28Rattus_norvegicus%29_also_called_Norway_Rat_or_Common_Rat_-with_food_container_-_Mathias_Baldwin_Park%2C_Philadelphia%2C_Pennsylvania%2C_USA.jpg","ratio":1.5002148689299528,"link":"https://commons.wikimedia.org/wiki/File:Brown_Rat_(Rattus_norvegicus)_also_called_Norway_Rat_or_Common_Rat_-with_food_container_-_Mathias_Baldwin_Park,_