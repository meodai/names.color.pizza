.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Aduana_Rosario.jpg/1280px-Aduana_Rosario.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Aduana_Rosario.jpg/500px-Aduana_Rosario.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Rosario's old Customs Office, on Belgrano Avenue","link":"https://en.wikipedia.org/wiki/File%3AAduana_Rosario.jpg"}],"sounds":{"ridge":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/09/En-us-ridge.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/09/En-us-ridge.ogg/En-us-ridge.ogg.mp3"}]}}}