ies_and_explorationsV2en.png"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/RENDANG_AYAM.jpg/500px-RENDANG_AYAM.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/RENDANG_AYAM.jpg/1280px-RENDANG_AYAM.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5d/RENDANG_AYAM.jpg/500px-RENDANG_AYAM.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Oil gives rendang its signature glossy finish.[14]: 351  Turmeric leaves are sliced as garnishes.","link":"https://en.wikipedia.org/wiki/File%3ARENDANG_AYAM.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Memasak_Rendang.jpg/500px-Memasak_Rendang.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Memasak_Rendang.jpg/1280px-Memasak_Rendang.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Memasak_Rendang.jpg/500px-Memasak_Rendang.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":" A group of women preparing randang in West Sumatra.","link":"https://en.wikipedia.org/wiki/File%3AMemasak_Rendang.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/D2D_9828_wikimedia2020_deni_dahniel_marandang_dagiang.jpg/500px-D2D_9828_wikimedia2020_deni_dahniel_marandang_dagiang.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/D2D_9828_wikimedia2020_deni_dahniel_marandang_dagiang.jpg/1280px-D2D_9828_wikimedia2020_deni_dahniel_marandang_dagiang.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d1/D2D_9828_wiki