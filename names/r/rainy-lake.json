ntent=thumbnail","alt":"Orographic precipitation","link":"https://en.wikipedia.org/wiki/File%3ASteigungsregen.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Sturmfront_auf_Doppler-Radar-Schirm.jpg/500px-Sturmfront_auf_Doppler-Radar-Schirm.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Sturmfront_auf_Doppler-Radar-Schirm.jpg/500px-Sturmfront_auf_Doppler-Radar-Schirm.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Band of thunderstorms seen on a weather radar display","link":"https://en.wikipedia.org/wiki/File%3ASturmfront_auf_Doppler-Radar-Schirm.jpg"}],"sounds":{}}}