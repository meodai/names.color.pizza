parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Hetch_Hetchy_Releases_%285910591819%29.jpg/1280px-Hetch_Hetchy_Releases_%285910591819%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Hetch_Hetchy_Releases_%285910591819%29.jpg/500px-Hetch_Hetchy_Releases_%285910591819%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Rainbows are formed by dispersion of light, in which the refraction angle depends on the light's frequency.","link":"https://en.wikipedia.org/wiki/File%3AHetch_Hetchy_Releases_(5910591819).jpg"}],"sounds":{"reef":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/03/En-us-reef.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/03/En-us-reef.ogg/En-us-reef.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/0a/En-au-reef.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0a/En-au-reef.ogg/En-au-reef.ogg.mp3"}]}}}