mons/thumb/a/ab/Bristol_tenn_ridgelines2.jpg/500px-Bristol_tenn_ridgelines2.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A strike ridge within the Appalachian Mountains","link":"https://en.wikipedia.org/wiki/File%3ABristol_tenn_ridgelines2.jpg"}],"sounds":{}}}