{"name":"Revered","hex":"#a78faf","fetched":"2026-10-12","looked":{"definitions":[{"term":"revered","whole":true,"parts":[{"part":"Verb","definitions":["simple past and past participle of revere"]},{"part":"Adjective","definitions":["Respected or given reverence."]}],"link":"https://en.wiktionary.org/wiki/revered"}],"entries":[{"title":"Deference","blocks":[{"text":"Deference is the condition of submitting to the espoused, legitimate influence of one's superior or superiors. Deference implies a yielding or submitting to the judgment of a recognized superior, out of respect or reverence. Deference has been studied extensively by political scientists, sociologists, and psychologists."}],"link":"https://en.wikipedia.org/wiki/Deference"}],"images":[],"sounds":{"revered":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/a/a4/LL-Q1860_%28eng%29-Vealhurl-revered.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/LL-Q1860_%28eng%29-Vealhurl-revered.wav/LL-Q1860_%28eng%29-Vealhurl-revered.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a4/LL-Q1860_%28eng%29-Vealhurl-revered.wav/LL-Q1860_%28eng%29-Vealhurl-revered.wav.ogg"}]}}}