{"name":"Plaudit","hex":"#39536c","fetched":"2026-10-12","looked":{"definitions":[{"term":"plaudit","whole":true,"parts":[{"part":"Noun","definitions":["A mark or expression of applause; praise bestowed.","An award or commendation; a formal recognition of approval or achievement."]},{"part":"Verb","definitions":["To issue or confer a plaudit upon."]}],"link":"https://en.wiktionary.org/wiki/plaudit"}],"entries":[{"title":"Plaudit","blocks":[{"text":"Plaudit (1895–1919) was an American Thoroughbred racehorse. A descendant of the English Triple Crown champion, West Australian, he was bred by Dr. John D. Neet, owner of Kindergarten Stud at Versailles, Kentucky. Plaudit is best known for winning the 1898 Kentucky Derby."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Plaudit%2C_winner_of_the_1898_Kentucky_Derby.png/330px-Plaudit%2C_winner_of_the_1898_Kentucky_Derby.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Plaudit","wikidata":"Q7202876"}],"images":[],"sounds":{"plaudit":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/3/38/LL-Q1860_%28eng%29-Vealhurl-plaudit.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/LL-Q1860_%28eng%29-Vealhurl-plaudit.wav/LL-Q1860_%28eng%29-Vealhurl-plaudit.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/38/LL-Q1860_%28eng%29-Vealhurl-plaudit.wav/LL-Q1860_%28eng%29-Vealhurl-plaudit.wav.ogg"}]}}}