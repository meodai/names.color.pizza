_Berry_parachute.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Albert_Berry_parachute.jpg/250px-Albert_Berry_parachute.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Albert Berry collapses his parachute on Kinloch Field at Jefferson Barracks, Missouri, after his jump on 1 March 1912.","link":"https://en.wikipedia.org/wiki/File%3AAlbert_Berry_parachute.jpg"}],"sounds":{"parachute":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/8e/En-us-parachute.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8e/En-us-parachute.ogg/En-us-parachute.ogg.mp3"}],"purple":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/b/bb/En-us-purple.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/En-us-purple.ogg/En-us-purple.ogg.mp3"}]}}}