dence","link":"https://en.wikipedia.org/wiki/File%3ATeal_male_(54310739035).jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Saturation_of_digital_colors.png/500px-Saturation_of_digital_colors.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Saturation_of_digital_colors.png/500px-Saturation_of_digital_colors.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"7.5PB and 10BG Munsell hue pages of RGB colors, showing lines of uniform saturation (chroma in proportion to lightness) in red. Lines of uniform saturation radiate from near the black point, while lines of uniform chroma are vertical. Also compared to the 10BG colors, the 7.5PB colors attain higher saturation as well as higher chroma.","link":"https://en.wikipedia.org/wiki/File%3ASaturation_of_digital_colors.png"}],"sounds":{"pale":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/e/e2/En-us-pale.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e2/En-us-pale.ogg/En-us-pale.ogg.mp3"}],"teal":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/c/cf/LL-Q1860_%28eng%29-Vealhurl-teal.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cf/LL-Q1860_%28eng%29-Vealhurl-teal.wav/LL-Q1860_%28eng%29-Vealhurl-teal.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/cf/LL-Q1860_%28eng%29-Vealhurl-teal.wav/LL-Q1860_%28eng%29-Vealhurl-teal.wav.ogg"}]}}}