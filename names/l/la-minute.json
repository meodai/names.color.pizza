{"name":"La Minute","hex":"#f5e5dc","fetched":"2026-10-12","looked":{"definitions":[{"term":"minute","whole":false,"parts":[{"part":"Noun","definitions":["A unit of time which is one sixtieth of an hour (sixty seconds).","A short but unspecified time period."]},{"part":"Verb","definitions":["Of an event, to write in a memo or the minutes of a meeting.","To set down a short sketch or note of; to jot down; to make a minute or a brief summary of."]}],"link":"https://en.wiktionary.org/wiki/minute"}],"entries":[{"title":"Minute","blocks":[{"text":"A minute is a unit of time defined as equal to 60 seconds. The prime symbol ′ is also sometimes used informally to denote minutes."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Clock_12-01.svg/330px-Clock_12-01.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Minute","wikidata":"Q7727"}],"images":[],"sounds":{"minute":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/83/En-uk-a_minute.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/83/En-uk-a_minute.ogg/En-uk-a_minute.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/c/c5/En-us-minute-noun.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c5/En-us-minute-noun.ogg/En-us-minute-noun.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/0e/En-us-minute-adjective.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/En-us-minute-adjective.ogg/En-us-minute-adjective.ogg.mp3"}]}}}