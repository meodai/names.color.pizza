/White_Heron_Closeup.jpg/500px-White_Heron_Closeup.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/White_Heron_Closeup.jpg/1280px-White_Heron_Closeup.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/White_Heron_Closeup.jpg/500px-White_Heron_Closeup.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A white heron with a droplet of water on its beak in Forest Park.","link":"https://en.wikipedia.org/wiki/File%3AWhite_Heron_Closeup.jpg"}],"sounds":{}}}