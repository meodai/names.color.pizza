.wikimedia.org/wikipedia/commons/thumb/a/ab/Pizza_toast%2C_at_Gusto.jpg/500px-Pizza_toast%2C_at_Gusto.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Pizza_toast%2C_at_Gusto.jpg/1280px-Pizza_toast%2C_at_Gusto.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Pizza_toast%2C_at_Gusto.jpg/500px-Pizza_toast%2C_at_Gusto.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Pizza toast","link":"https://en.wikipedia.org/wiki/File%3APizza_toast%2C_at_Gusto.jpg"}],"sounds":{"toasted":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/0e/En-au-toasted.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0e/En-au-toasted.ogg/En-au-toasted.ogg.mp3"}]}}}