kipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/PanoSantPere.jpg/500px-PanoSantPere.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"At the beginning of nautical twilight, artificial lighting must be used to see terrestrial objects clearly.","link":"https://en.wikipedia.org/wiki/File%3APanoSantPere.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Astronomical_Twilight.png/500px-Astronomical_Twilight.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Astronomical_Twilight.png/1280px-Astronomical_Twilight.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Astronomical_Twilight.png/500px-Astronomical_Twilight.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Astronomical twilight photographed with the Sun being approximately 15° below the horizon.","link":"https://en.wikipedia.org/wiki/File%3AAstronomical_Twilight.png"}],"sounds":{"twilight":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/8a/En-us-twilight.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8a/En-us-twilight.ogg/En-us-twilight.ogg.mp3"}],"meadow":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/00/En-us-meadow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/En-us-meadow.ogg/En-us-meadow.ogg.mp3"}]}}}