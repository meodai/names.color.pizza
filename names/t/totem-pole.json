op_of_Seward_Pole.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Totem_Pole_-_Pioneer_Square_-_1907.jpg/500px-Totem_Pole_-_Pioneer_Square_-_1907.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/Totem_Pole_-_Pioneer_Square_-_1907.jpg/500px-Totem_Pole_-_Pioneer_Square_-_1907.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Tlingit totem pole brought from Alaska to Pioneer Square in Seattle; it continues to stand as of 2023.","link":"https://en.wikipedia.org/wiki/File%3ATotem_Pole_-_Pioneer_Square_-_1907.jpg"}],"sounds":{"totem pole":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/e/ed/LL-Q1860_%28eng%29-Vealhurl-totem_pole.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ed/LL-Q1860_%28eng%29-Vealhurl-totem_pole.wav/LL-Q1860_%28eng%29-Vealhurl-totem_pole.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ed/LL-Q1860_%28eng%29-Vealhurl-totem_pole.wav/LL-Q1860_%28eng%29-Vealhurl-totem_pole.wav.ogg"}]}}}