d as streaks.","link":"https://en.wikipedia.org/wiki/File%3AFogParticles.jpg"}],"sounds":{"tropical":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/5/52/LL-Q1860_%28eng%29-Back_ache-tropical.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/LL-Q1860_%28eng%29-Back_ache-tropical.wav/LL-Q1860_%28eng%29-Back_ache-tropical.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/52/LL-Q1860_%28eng%29-Back_ache-tropical.wav/LL-Q1860_%28eng%29-Back_ache-tropical.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/c/c8/En-us-tropical.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/c/c8/En-us-tropical.ogg/En-us-tropical.ogg.mp3"}],"fog":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/4/45/En-us-fog.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/45/En-us-fog.ogg/En-us-fog.ogg.mp3"}]}}}