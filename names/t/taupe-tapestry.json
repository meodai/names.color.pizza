estry.png/500px-Odo_bayeux_tapestry.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A scene from the Bayeux Tapestry depicting Odo, Bishop of Bayeux, rallying Duke William's troops during the Battle of Hastings in 1066","link":"https://en.wikipedia.org/wiki/File%3AOdo_bayeux_tapestry.png"}],"sounds":{"taupe":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/5/5b/En-us-taupe.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5b/En-us-taupe.ogg/En-us-taupe.ogg.mp3"}],"tapestry":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/a/a8/En-us-tapestry.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a8/En-us-tapestry.ogg/En-us-tapestry.ogg.mp3"}]}}}