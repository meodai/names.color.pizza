{"name":"Thermal","hex":"#3f5052","fetched":"2026-10-13","looked":{"definitions":[{"term":"Thermal","whole":true,"parts":[{"part":"Proper noun","definitions":["A census-designated place in Riverside County, California, United States."]}],"link":"https://en.wiktionary.org/wiki/Thermal"}],"entries":[{"title":"Thermal","blocks":[{"text":"A thermal column is a rising mass of buoyant air, a convective current in the atmosphere, that transfers heat energy vertically. Thermals are created by the uneven heating of Earth's surface from solar radiation, and are an example of convection, specifically atmospheric convection."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f0/Thermal_column.svg/330px-Thermal_column.svg.png?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Thermal","wikidata":"Q752823"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Bubble_or_vortex_ring_thermal_model.jpg/500px-Bubble_or_vortex_ring_thermal_model.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Bubble_or_vortex_ring_thermal_model.jpg/500px-Bubble_or_vortex_ring_thermal_model.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3ABubble_or_vortex_ring_thermal_model.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Column_or_plume_thermal_model.jpg/500px-Column_or_plume_thermal_model.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Column_or_plume_thermal_model.jpg/500px-Column_or_plume_thermal_model.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3AColumn_or_plume_thermal_model.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commo