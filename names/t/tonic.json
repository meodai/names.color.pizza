ia.org/wikipedia/commons/thumb/1/16/Maxwell_Prices_2005.JPG/500px-Maxwell_Prices_2005.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Price list at Chicago's Express Grill, showing the word \"pop\" at the bottom","link":"https://en.wikipedia.org/wiki/File%3AMaxwell_Prices_2005.JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Emerson_Hart_and_Jeff_Russo_of_Tonic.jpg/330px-Emerson_Hart_and_Jeff_Russo_of_Tonic.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Emerson_Hart_and_Jeff_Russo_of_Tonic.jpg/330px-Emerson_Hart_and_Jeff_Russo_of_Tonic.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Hart and Russo in 2002","link":"https://en.wikipedia.org/wiki/File%3AEmerson_Hart_and_Jeff_Russo_of_Tonic.jpg"}],"sounds":{"tonic":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/e/e7/LL-Q1860_%28eng%29-Vealhurl-tonic.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e7/LL-Q1860_%28eng%29-Vealhurl-tonic.wav/LL-Q1860_%28eng%29-Vealhurl-tonic.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e7/LL-Q1860_%28eng%29-Vealhurl-tonic.wav/LL-Q1860_%28eng%29-Vealhurl-tonic.wav.ogg"}]}}}