_Global_Circulation.jpg/500px-Earth_Global_Circulation.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Earth_Global_Circulation.jpg/500px-Earth_Global_Circulation.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Winds are part of Earth's atmospheric circulation","link":"https://en.wikipedia.org/wiki/File%3AEarth_Global_Circulation.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Franklingulfstream.jpg/500px-Franklingulfstream.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Franklingulfstream.jpg/1280px-Franklingulfstream.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Franklingulfstream.jpg/500px-Franklingulfstream.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Benjamin Franklin's map of the Gulf Stream","link":"https://en.wikipedia.org/wiki/File%3AFranklingulfstream.jpg"}],"sounds":{"wind":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/4/44/En-uk-wind.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/44/En-uk-wind.ogg/En-uk-wind.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/2/25/En-us-wind-air.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/25/En-us-wind-air.ogg/En-us-wind-air.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/2/29/En-us-wind-turn.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"