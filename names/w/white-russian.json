1280px-Kurapaty_1989_meeting.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Kurapaty_1989_meeting.jpg/500px-Kurapaty_1989_meeting.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Meeting in the Kurapaty woods, 1989, where between 1937 and 1941 from 30,000 to 250,000 people, including Belarusian intelligentsia members, were murdered by the NKVD during the Great Purge","link":"https://en.wikipedia.org/wiki/File%3AKurapaty_1989_meeting.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Bundesarchiv_Bild_101I-137-1010-37A%2C_Minsk%2C_deutsche_Truppen_vor_modernen_Geb%C3%A4uden.jpg/500px-Bundesarchiv_Bild_101I-137-1010-37A%2C_Minsk%2C_deutsche_Truppen_vor_modernen_Geb%C3%A4uden.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Bundesarchiv_Bild_101I-137-1010-37A%2C_Minsk%2C_deutsche_Truppen_vor_modernen_Geb%C3%A4uden.jpg/500px-Bundesarchiv_Bild_101I-137-1010-37A%2C_Minsk%2C_deutsche_Truppen_vor_modernen_Geb%C3%A4uden.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"German soldiers in Minsk, August 1941","link":"https://en.wikipedia.org/wiki/File%3ABundesarchiv_Bild_101I-137-1010-37A%2C_Minsk%2C_deutsche_Truppen_vor_modernen_Geb%C3%A4uden.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Hatiny1.jpg/500px-Hatiny1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Hatiny1.jpg/1280px-Hatiny1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Hatiny1.jpg/500px-Hatiny1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Khatyn Memorial; during World War II the German Nazis murdered civilians in 5,295 different localities in occupied Soviet Belarus.","link":"https://en.wikipedia.org/wiki/File%3AHatiny1.jpg"}],"sounds":{"White Russian":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/e/e0/LL-Q1860_%28eng%29-Flame%2C_not_lame-White_Russian.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/LL-Q1860_%28eng%29-Flame%2C_not_lame-White_Russian.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-White_Russian.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e0/LL-Q1860_%28eng%29-Flame%2C_not_lame-White_Russian.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-White_Russian.wav.ogg"}]}}}