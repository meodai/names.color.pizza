.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Leaf_Varieties_%2815_sp%29.png/1280px-Leaf_Varieties_%2815_sp%29.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Leaf_Varieties_%2815_sp%29.png/500px-Leaf_Varieties_%2815_sp%29.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The diversity of leaves, including Bismarckia, Araucaria, Euphorbia, Nymphaea, Colocasia, Hildegardia, Picea, Melocactus, Cycas, Acer, Yucca, Ferocactus, and Ocimum.","link":"https://en.wikipedia.org/wiki/File%3ALeaf_Varieties_(15_sp).png"}],"sounds":{"gilded":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/d6/En-us-gilded-adj.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d6/En-us-gilded-adj.ogg/En-us-gilded-adj.ogg.mp3"}],"leaves":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/9/98/LL-Q1860_%28eng%29-Back_ache-leaves.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/LL-Q1860_%28eng%29-Back_ache-leaves.wav/LL-Q1860_%28eng%29-Back_ache-leaves.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/98/LL-Q1860_%28eng%29-Back_ache-leaves.wav/LL-Q1860_%28eng%29-Back_ache-leaves.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/2/23/En-us-leaves.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/23/En-us-leaves.ogg/En-us-leaves.ogg.mp3"}]}}}