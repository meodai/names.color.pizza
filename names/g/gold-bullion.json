.org/wikipedia/commons/d/d5/Beowulf_-_gold.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled 1x","src":"https://upload.wikimedia.org/wikipedia/commons/d/d5/Beowulf_-_gold.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled","alt":"The word gold in the Beowulf manuscript","link":"https://en.wikipedia.org/wiki/File%3ABeowulf_-_gold.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg/500px-Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg/1280px-Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg/500px-Small_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"A 5 mm (0.20 in) gold nugget (dot in front of frame) can be hammered into a gold foil of about 0.5 m2 (5.4 sq ft) in area.","link":"https://en.wikipedia.org/wiki/File%3ASmall_gold_nugget_5mm_dia_and_corresponding_foil_surface_of_half_sq_meter.jpg"}],"sounds":{}}}