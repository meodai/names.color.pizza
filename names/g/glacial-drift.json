g/500px-Ground_moraine_9004.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Ground_moraine_9004.jpg/1280px-Ground_moraine_9004.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Ground_moraine_9004.jpg/500px-Ground_moraine_9004.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Ground moraines create irregular, rolling topography near Gainesville, New York.","link":"https://en.wikipedia.org/wiki/File%3AGround_moraine_9004.jpg"}],"sounds":{},"pictures":[]}}