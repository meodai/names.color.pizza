{"name":"Freshman","hex":"#e6f2c4","fetched":"2026-10-12","looked":{"definitions":[{"term":"freshman","whole":true,"parts":[{"part":"Noun","definitions":["a person (of either sex) entering the first year of an institution, especially a high school (ninth grade for US, grade 9 for  Canada, grade 7 for Philippines), a university, or legislative body","a novice; one in the rudiments of knowledge"]}],"link":"https://en.wiktionary.org/wiki/freshman"}],"entries":[{"title":"Freshman","blocks":[{"text":"A freshman, fresher, first year, or colloquially frosh, is a person in the first year at an educational institution, usually a secondary school or at the college and university level, but also in other forms of post-secondary educational institutions or primary school."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/1920_Locust_yearbook_p._095_%28Freshman%29.jpg/330px-1920_Locust_yearbook_p._095_%28Freshman%29.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Freshman","wikidata":"Q13883551"}],"images":[],"sounds":{"freshman":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/f/f0/LL-Q1860_%28eng%29-Vealhurl-freshman.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f0/LL-Q1860_%28eng%29-Vealhurl-freshman.wav/LL-Q1860_%28eng%29-Vealhurl-freshman.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/f0/LL-Q1860_%28eng%29-Vealhurl-freshman.wav/LL-Q1860_%28eng%29-Vealhurl-freshman.wav.ogg"}]},"pictures":[{"title":"El Rodeo (1908) (147113)","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b2/El_Rodeo_%281908%29_%28147113%29.jpg/500px-El_Rodeo_%281908%29_%28147113%29.jpg","ratio":1.5208121827411167,"link":"https://commons.wikimedia.org/wiki/File:El_Rodeo_(1908)_(147113).jpg","share":0.539375}