i.jpg"},{"srcset":"https://upload.wikimedia.org/wikipedia/commons/9/92/Colleen_Fitzpatrick_ca_2001.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled 1x","src":"https://upload.wikimedia.org/wikipedia/commons/9/92/Colleen_Fitzpatrick_ca_2001.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail_unscaled","alt":"Fitzpatrick at a record signing event in 2001","link":"https://en.wikipedia.org/wiki/File%3AColleen_Fitzpatrick_ca_2001.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png/500px-J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png/1280px-J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png/500px-J._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_%28Vitamins%29%2C_1920.png?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Jack Drummond's single-paragraph article in 1920 which provided structure and nomenclature used today for vitamins","link":"https://en.wikipedia.org/wiki/File%3AJ._C._Drummond%2C_The_Nomenclature_of_the_So-called_Accessory_Food_Factors_(Vitamins)%2C_1920.png"}],"sounds":{"vitamin":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/c/ca/En-us-vitamin.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=origin