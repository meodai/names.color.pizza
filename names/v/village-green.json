_(50530045216).jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Harpsichord_Girolamo_Zenti.jpg/500px-Harpsichord_Girolamo_Zenti.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Harpsichord_Girolamo_Zenti.jpg/500px-Harpsichord_Girolamo_Zenti.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The recording prominently features a harpsichord, giving the song a Baroque-feel.","link":"https://en.wikipedia.org/wiki/File%3AHarpsichord_Girolamo_Zenti.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/NewHavenGreenCTSouvenirPic1919-1.jpg/500px-NewHavenGreenCTSouvenirPic1919-1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/NewHavenGreenCTSouvenirPic1919-1.jpg/500px-NewHavenGreenCTSouvenirPic1919-1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"New Haven Green, c. 1919","link":"https://en.wikipedia.org/wiki/File%3ANewHavenGreenCTSouvenirPic1919-1.jpg"}],"sounds":{}}}