{"name":"Vintner","hex":"#68546a","fetched":"2026-10-13","looked":{"definitions":[{"term":"vintner","whole":true,"parts":[{"part":"Noun","definitions":["A seller of wine.","A manufacturer of wine."]}],"link":"https://en.wiktionary.org/wiki/vintner"}],"entries":[{"title":"Winemaker","blocks":[{"text":"A winemaker or vintner is a person engaged in winemaking. They are generally employed by wineries or wine companies, where their work includes:"},{"items":["Cooperating with viticulturists","Monitoring the maturity of grapes to ensure their quality and to determine the correct time for harvest","Crushing and pressing grapes","Monitoring the settling of juice and the fermentation of grape material","Filtering the wine to remove remaining solids","Testing the quality of wine by tasting","Placing filtered wine in casks or tanks for storage and maturation","Preparing plans for bottling wine once it has matured","Making sure that quality is maintained when the wine is bottled"]}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Vigneron.jpg/330px-Vigneron.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Winemaker"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Grapes.jpg/500px-Grapes.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Grapes.jpg/1280px-Grapes.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Grapes.jpg/500px-Grapes.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Wine grapes","link":"https://en.wikipedia.org/wiki/File%3AGrapes.jpg"}],"sounds":{"vintner":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/b/b5/LL-Q1860_%28eng%29-Vealhurl-vintner.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"typ