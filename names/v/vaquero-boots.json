pedia.org/wiki/File%3ATrajes_Mexicanos%2C_Rancheros_y_Campesinos.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Mexican_Cabellero%2C_by_Doerr_%26_Jacobson_%28cropped%29.jpg/500px-Mexican_Cabellero%2C_by_Doerr_%26_Jacobson_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/07/Mexican_Cabellero%2C_by_Doerr_%26_Jacobson_%28cropped%29.jpg/500px-Mexican_Cabellero%2C_by_Doerr_%26_Jacobson_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Image of a man and horse in Mexican-style equipment, horse in a two-rein bridle","link":"https://en.wikipedia.org/wiki/File%3AMexican_Cabellero%2C_by_Doerr_%26_Jacobson_(cropped).jpg"}],"sounds":{"boots":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/2/2e/En-us-boots.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/2/2e/En-us-boots.ogg/En-us-boots.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/3c/En-au-boots.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3c/En-au-boots.ogg/En-au-boots.ogg.mp3"}]}}}