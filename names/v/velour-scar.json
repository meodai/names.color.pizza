.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Key_processes_contributing_to_the_quasi-neoplastic_expression_of_keloid_pathobiology.jpg/500px-Key_processes_contributing_to_the_quasi-neoplastic_expression_of_keloid_pathobiology.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Key processes contributing to the quasi-neoplastic expression of keloid pathobiology","link":"https://en.wikipedia.org/wiki/File%3AKey_processes_contributing_to_the_quasi-neoplastic_expression_of_keloid_pathobiology.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Scar_revision.jpg/500px-Scar_revision.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ea/Scar_revision.jpg/500px-Scar_revision.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Scarring caused by acne (left), and photo one day after scar revision surgery: The area around sutures is still swollen from surgery.","link":"https://en.wikipedia.org/wiki/File%3AScar_revision.jpg"}],"sounds":{"velour":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/e/e4/LL-Q1860_%28eng%29-Flame%2C_not_lame-velour.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e4/LL-Q1860_%28eng%29-Flame%2C_not_lame-velour.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-velour.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/e4/LL-Q1860_%28eng%29-Flame%2C_not_lame-velour.wav/LL-Q1860_%28eng%29-Flame%2C_not_lame-velour.wav.ogg"}],"scar":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/a/a6/En-ca-scar.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"