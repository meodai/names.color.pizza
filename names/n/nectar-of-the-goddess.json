oral_nectary.jpg/330px-Nylanderia_flavipes_extrafloral_nectary.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Nylanderia_flavipes_extrafloral_nectary.jpg/330px-Nylanderia_flavipes_extrafloral_nectary.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Nylanderia flavipes ant visiting extrafloral nectaries of Senna","link":"https://en.wikipedia.org/wiki/File%3ANylanderia_flavipes_extrafloral_nectary.jpg"}],"sounds":{"nectar":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/b/bb/LL-Q1860_%28eng%29-Vealhurl-nectar.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/LL-Q1860_%28eng%29-Vealhurl-nectar.wav/LL-Q1860_%28eng%29-Vealhurl-nectar.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/bb/LL-Q1860_%28eng%29-Vealhurl-nectar.wav/LL-Q1860_%28eng%29-Vealhurl-nectar.wav.ogg"}],"goddess":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/de/En-us-goddess.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/de/En-us-goddess.ogg/En-us-goddess.ogg.mp3"}]}}}