n.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Sunset_on_the_Moon.webp/500px-Sunset_on_the_Moon.webp?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Sunset on the moon captured by Blue Ghost.","link":"https://en.wikipedia.org/wiki/File%3ASunset_on_the_Moon.webp"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/MarsSunset.jpg/500px-MarsSunset.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/MarsSunset.jpg/1280px-MarsSunset.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/69/MarsSunset.jpg/500px-MarsSunset.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Sunset on Mars captured by the Mars rover Spirit.","link":"https://en.wikipedia.org/wiki/File%3AMarsSunset.jpg"}],"sounds":{"nightfall":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/00/En-us-nightfall.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/00/En-us-nightfall.ogg/En-us-nightfall.ogg.mp3"}]}}}