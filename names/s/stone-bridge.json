-Bauarbeiten_an_der_Steinernen_Br%C3%BCcke_in_Regensburg_-_geograph.org.uk_-_8585.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Bauarbeiten_an_der_Steinernen_Br%C3%BCcke_in_Regensburg_-_geograph.org.uk_-_8585.jpg/500px-Bauarbeiten_an_der_Steinernen_Br%C3%BCcke_in_Regensburg_-_geograph.org.uk_-_8585.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"North end of the bridge under repair in March 2010","link":"https://en.wikipedia.org/wiki/File%3ABauarbeiten_an_der_Steinernen_Br%C3%BCcke_in_Regensburg_-_geograph.org.uk_-_8585.jpg"}],"sounds":{"stone":[{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/3/37/LL-Q1860_%28eng%29-Back_ache-stone.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/37/LL-Q1860_%28eng%29-Back_ache-stone.wav/LL-Q1860_%28eng%29-Back_ache-stone.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/37/LL-Q1860_%28eng%29-Back_ache-stone.wav/LL-Q1860_%28eng%29-Back_ache-stone.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/b/b4/En-us-stone.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b4/En-us-stone.ogg/En-us-stone.ogg.mp3"}],"bridge":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/8f/En-us-bridge.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8f/En-us-bridge.ogg/En-us-bridge.ogg.mp3"}]}}}