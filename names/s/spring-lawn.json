cy","link":"https://en.wikipedia.org/wiki/File%3AVaux-le-Vicomte_Garten.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/BadmintonMorris_edited.jpg/500px-BadmintonMorris_edited.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2b/BadmintonMorris_edited.jpg/500px-BadmintonMorris_edited.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Capability Brown's landscape design at Badminton House","link":"https://en.wikipedia.org/wiki/File%3ABadmintonMorris_edited.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/J%C3%A1nos_Rombauer_-_English_Garden_in_the_Cs%C3%A1ky_Castle_at_Hotk%C3%B3c_-_WGA20009.jpg/500px-J%C3%A1nos_Rombauer_-_English_Garden_in_the_Cs%C3%A1ky_Castle_at_Hotk%C3%B3c_-_WGA20009.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/55/J%C3%A1nos_Rombauer_-_English_Garden_in_the_Cs%C3%A1ky_Castle_at_Hotk%C3%B3c_-_WGA20009.jpg/500px-J%C3%A1nos_Rombauer_-_English_Garden_in_the_Cs%C3%A1ky_Castle_at_Hotk%C3%B3c_-_WGA20009.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"1803 painting of the main elements of the English landscape garden","link":"https://en.wikipedia.org/wiki/File%3AJ%C3%A1nos_Rombauer_-_English_Garden_in_the_Cs%C3%A1ky_Castle_at_Hotk%C3%B3c_-_WGA20009.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Kirby_Fleetham_Hall%2C_Yorkshire%2C_UK%2C_lawn%2C_1889.jpg/500px-Kirby_Fleetham_Hall%2C_Yorkshire%2C_UK%2C_lawn%2C_1889.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Kirby_Fleetham_Hall%2C_Yorkshire%2C_UK%2C_lawn%2C_1889.jpg/1280px-Kirby_Fleetham_Hall%2C_Yorkshire%2C_UK%2C_lawn%2C_1889.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail