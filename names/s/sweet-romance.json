.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Marianne_Stokes05.jpg/500px-Marianne_Stokes05.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Aucassin and Nicolette, by Marianne Stokes","link":"https://en.wikipedia.org/wiki/File%3AMarianne_Stokes05.jpg"}],"sounds":{"sweet":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/d7/En-us-sweet.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d7/En-us-sweet.ogg/En-us-sweet.ogg.mp3"}],"romance":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/e/ec/En-us-romance.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ec/En-us-romance.ogg/En-us-romance.ogg.mp3"}]}}}