{"name":"Sandy Bluff","hex":"#aca088","fetched":"2026-10-13","looked":{"definitions":[{"term":"sandy","whole":false,"parts":[{"part":"Adjective","definitions":["Covered with sand.","Sprinkled with sand."]},{"part":"Noun","definitions":["A sandwich","Ellipsis of pecan sandy."]}],"link":"https://en.wiktionary.org/wiki/sandy"},{"term":"bluff","whole":false,"parts":[{"part":"Noun","definitions":["An act of bluffing; a false expression of the strength of one’s position in order to intimidate or deceive; braggadocio.","An attempt to represent oneself as holding a stronger hand than one actually does."]},{"part":"Verb","definitions":["To make a bluff; to give the impression that one’s hand is stronger than it is.","To frighten, deter, or deceive with a false show of strength or confidence; to give a false impression of strength or temerity in order to intimidate or gain some advantage."]}],"link":"https://en.wiktionary.org/wiki/bluff"}],"entries":[],"images":[],"sounds":{"sandy":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/0d/En-us-sandy.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0d/En-us-sandy.ogg/En-us-sandy.ogg.mp3"}],"bluff":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/34/En-au-bluff.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/34/En-au-bluff.ogg/En-au-bluff.ogg.mp3"}]}}}