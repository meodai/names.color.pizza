ace.[22]","link":"https://en.wikipedia.org/wiki/File%3APurcell%E2%80%99s_swimming_scallop_with_reciprocal_motion.png"}],"sounds":{"oak":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/da/En-us-oak.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/da/En-us-oak.ogg/En-us-oak.ogg.mp3"}]}}}