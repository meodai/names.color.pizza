nk":"https://en.wikipedia.org/wiki/File%3AEarth-satellite-seasons.gif"}],"sounds":{"snow":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/9/96/En-uk-snow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/9/96/En-uk-snow.ogg/En-uk-snow.ogg.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/d/d8/En-us-snow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/d/d8/En-us-snow.ogg/En-us-snow.ogg.mp3"}],"flurry":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/6/61/En-us-flurry.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/61/En-us-flurry.ogg/En-us-flurry.ogg.mp3"}]}}}