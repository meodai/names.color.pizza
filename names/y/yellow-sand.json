.","link":"https://en.wikipedia.org/wiki/File%3ACoralPinkSandDunesSand.JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/PismoBeachSand.JPG/500px-PismoBeachSand.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/PismoBeachSand.JPG/1280px-PismoBeachSand.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/PismoBeachSand.JPG/500px-PismoBeachSand.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Sand from Pismo Beach, California. Components are primarily quartz, chert, igneous rock, and shell fragments.","link":"https://en.wikipedia.org/wiki/File%3APismoBeachSand.JPG"}],"sounds":{"yellow":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/6/65/En-uk-yellow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/6/65/En-uk-yellow.ogg/En-uk-yellow.ogg.mp3"},{"type":"audio/wav","src":"https://upload.wikimedia.org/wikipedia/commons/f/ff/LL-Q1860_%28eng%29-Back_ache-yellow.wav?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/LL-Q1860_%28eng%29-Back_ache-yellow.wav/LL-Q1860_%28eng%29-Back_ache-yellow.wav.mp3"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/f/ff/LL-Q1860_%28eng%29-Back_ache-yellow.wav/LL-Q1860_%28eng%29-Back_ache-yellow.wav.ogg"},{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/8/8b/En-us-yellow.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/8b/En-us-yellow.ogg/En-us-y