g/500px-Irrigation1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Irrigation1.jpg/500px-Irrigation1.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The Green Revolution of the 20th century relied on hybridization to create high-yielding varieties, along with increased reliance on inputs of fertilizers, pesticides, and irrigation.[64]","link":"https://en.wikipedia.org/wiki/File%3AIrrigation1.jpg"}],"sounds":{"hybrid":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/a/a7/En-us-hybrid.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a7/En-us-hybrid.ogg/En-us-hybrid.ogg.mp3"}]},"pictures":[{"title":"Carpet beige and black","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Carpet_beige_and_black.jpg/500px-Carpet_beige_and_black.jpg","ratio":0.47368421052631576,"link":"https://commons.wikimedia.org/wiki/File:Carpet_beige_and_black.jpg","share":0.341875},{"title":"Hibuna-x-ryukin","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Hibuna-x-ryukin.jpg/500px-Hibuna-x-ryukin.jpg","ratio":1.7777777777777777,"link":"https://commons.wikimedia.org/wiki/File:Hibuna-x-ryukin.jpg","share":0.1275},{"title":"Tweedelige japon, knielange rok (2) van wit-beige stof in linnenlook met mouwloze hes (1) met naturel passement met kralenborduursel, “Cargelli”, objectnr 61920-1-2","image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Tweedelige_japon%2C_knielange_rok_%282%29_van_wit-beige_stof_in_linnenlook_met_mouwloze_hes_%281%29_met_naturel_passement_met_kralenborduursel%2C_%E2%80%9CCargelli%E2%80%9D%2C_objectnr_61920-1-2.JPG/500px-thumbnail.jpg","ratio":1.4938271604938271,"link":"https://commons.wikimedia.org/wiki/File:Tweedelige_japon,_knielange_rok_(2)_van_wit-bei