86"},{"title":"Coffee (color)","blocks":[{"text":"Coffee is a brownish color that is a representation of a roasted coffee bean. Different types of coffee beans have different colors when roasted—the color coffee represents an average."}],"image":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/Roasted_coffee_beans.jpg/330px-Roasted_coffee_beans.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","link":"https://en.wikipedia.org/wiki/Coffee_(color)","wikidata":"Q2932937"}],"images":[{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Haselnuss.jpg/500px-Haselnuss.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/32/Haselnuss.jpg/500px-Haselnuss.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Cracked hazelnut shell displaying the edible seed","link":"https://en.wikipedia.org/wiki/File%3AHaselnuss.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Corylus_colurna_%281%29.JPG/500px-Corylus_colurna_%281%29.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Corylus_colurna_%281%29.JPG/1280px-Corylus_colurna_%281%29.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Corylus_colurna_%281%29.JPG/500px-Corylus_colurna_%281%29.JPG?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Hazelnut tree, Turkey","link":"https://en.wikipedia.org/wiki/File%3ACorylus_colurna_(1).JPG"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Corylus_maxima_fruit.jpg/500px-Corylus_maxima_fruit.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Corylus_maxima_fruit.jpg/1280px-Corylus_maxima_fruit.jpg?utm_source=e