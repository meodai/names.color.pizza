a.org/wiki/File%3AAssyrian_Relief_of_the_Banquet_of_Ashurbanipal_From_Nineveh_Gypsum_N_Palace_British_Museum_01.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Biskupia_Gorka_executions_-_14_-_Barkmann%2C_Paradies%2C_Becker%2C_Klaff%2C_Steinhoff_%28left_to_right%29.jpg/500px-Biskupia_Gorka_executions_-_14_-_Barkmann%2C_Paradies%2C_Becker%2C_Klaff%2C_Steinhoff_%28left_to_right%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Biskupia_Gorka_executions_-_14_-_Barkmann%2C_Paradies%2C_Becker%2C_Klaff%2C_Steinhoff_%28left_to_right%29.jpg/500px-Biskupia_Gorka_executions_-_14_-_Barkmann%2C_Paradies%2C_Becker%2C_Klaff%2C_Steinhoff_%28left_to_right%29.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Execution of guards and kapos of the Stutthof concentration camp on 4 July 1946 by short-drop hanging. In the foreground are the female overseers: Jenny-Wanda Barkmann, Ewa Paradies, Elisabeth Becker, Wanda Klaff, Gerda Steinhoff (left to right).","link":"https://en.wikipedia.org/wiki/File%3ABiskupia_Gorka_executions_-_14_-_Barkmann%2C_Paradies%2C_Becker%2C_Klaff%2C_Steinhoff_(left_to_right).jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Hromadn%C3%A1_poprava_Srb%C5%AF.jpg/500px-Hromadn%C3%A1_poprava_Srb%C5%AF.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Hromadn%C3%A1_poprava_Srb%C5%AF.jpg/500px-Hromadn%C3%A1_poprava_Srb%C5%AF.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Mass execution using \"pole-hanging\" of Serbs by the Austro-Hungarian army in 1916","link":"https://en.wikipedia.org/wiki/File%3AHromadn%C3%A1_poprava_Srb%C5%AF.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Execution_of_Henry_Wirz.jpg/500px-Execution_of_Henry_Wirz.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Execution_of_Henry_Wirz.jpg/1280px-Execution_of_Henry_Wirz.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Execution_of_Henry_Wirz.jpg/500px-Execution_of_Henry_Wirz.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"The execution of Henry Wirz in 1865 with the U.S. Capitol dome in the background. Wirz was given a standard drop, which did not break his neck immediately. ","link":"https://en.wikipedia.org/wiki/File%3AExecution_of_Henry_Wirz.jpg"}],"sounds":{"hanging":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/a/a3/En-us-hanging.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/a/a3/En-us-hanging.ogg/En-us-hanging.ogg.mp3"}],"gardens":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/e/ef/En-us-gardens.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/e/ef/En-us-gardens.ogg/En-us-gardens.ogg.mp3"}]}}}