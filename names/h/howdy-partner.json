{"name":"Howdy Partner","hex":"#c6a698","fetched":"2026-10-12","looked":{"definitions":[{"term":"howdy","whole":false,"parts":[{"part":"Interjection","definitions":["An informal greeting."]},{"part":"Verb","definitions":["To greet informally, especially by saying \"howdy\""]}],"link":"https://en.wiktionary.org/wiki/howdy"},{"term":"partner","whole":false,"parts":[{"part":"Noun","definitions":["Either of a pair of people or things that belong together.","Someone who is associated with another in a common activity or interest."]},{"part":"Verb","definitions":["To join as a partner.","To work or perform as a partner."]}],"link":"https://en.wiktionary.org/wiki/partner"}],"entries":[{"title":"Howdy","blocks":[{"text":"Howdy is an informal salutation in the English language often used in the Southern United States. Originally a shortened form of the inquiry How do ye?, it was first used in Southern England in the 18th century."}],"link":"https://en.wikipedia.org/wiki/Howdy","wikidata":"Q1631958"}],"images":[],"sounds":{"howdy":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/3/3f/En-us-howdy.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/3/3f/En-us-howdy.ogg/En-us-howdy.ogg.mp3"}],"partner":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/b/b5/En-us-partner.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/b/b5/En-us-partner.ogg/En-us-partner.ogg.mp3"}]}}}