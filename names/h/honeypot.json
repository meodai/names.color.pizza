k":"https://en.wikipedia.org/wiki/File%3AHoney-miel.jpg"}],"sounds":{"honeypot":[{"type":"audio/ogg; codecs=\"vorbis\"","src":"https://upload.wikimedia.org/wikipedia/commons/0/0b/En-au-honeypot.ogg?utm_source=en.wiktionary.org&utm_campaign=rest&utm_content=original"},{"type":"audio/mpeg","src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/0/0b/En-au-honeypot.ogg/En-au-honeypot.ogg.mp3"}]}}}