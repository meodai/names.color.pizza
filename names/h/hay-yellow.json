.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/George_Stubbs_-_Haymaking_-_WGA21948.jpg/500px-George_Stubbs_-_Haymaking_-_WGA21948.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/George_Stubbs_-_Haymaking_-_WGA21948.jpg/500px-George_Stubbs_-_Haymaking_-_WGA21948.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"Haymakers by George Stubbs, 1785","link":"https://en.wikipedia.org/wiki/File%3AGeorge_Stubbs_-_Haymaking_-_WGA21948.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Swiss_hay_farmers_in_Versam.jpg/500px-Swiss_hay_farmers_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Swiss_hay_farmers_in_Versam.jpg/1280px-Swiss_hay_farmers_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Swiss_hay_farmers_in_Versam.jpg/500px-Swiss_hay_farmers_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","alt":"","link":"https://en.wikipedia.org/wiki/File%3ASwiss_hay_farmers_in_Versam.jpg"},{"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Young_farmer_on_a_hay_harvester_in_Versam.jpg/500px-Young_farmer_on_a_hay_harvester_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 1x, https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Young_farmer_on_a_hay_harvester_in_Versam.jpg/1280px-Young_farmer_on_a_hay_harvester_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail 2x","src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Young_farmer_on_a_hay_harvester_in_Versam.jpg/500px-Young_farmer_on_a_hay_harvester_in_Versam.jpg?utm_source=en.wikipedia.org&utm_campaign=parser&utm_content=thumbnail","